# Copy to .env (untracked) and fill in only what the provider you run needs.
# Names only — values never appear in prompts, PR bodies, or logs (FR-003).

# claude-via-proxy: the Anthropic-protocol proxy the Claude Code CLI talks to
# (becomes ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN inside the sandbox)
CLI_PROXY_API_URL=
CLI_PROXY_API_TOKEN=
# Optional: context window of the proxy model, for Claude Code auto-compact
# (default 200000 when unset).
#CLI_PROXY_MAX_CONTEXT_TOKENS=

# codex-direct: API key for the codex CLI
CODEX_API_KEY=

# opencode: API key for the opencode CLI
OPENCODE_API_KEY=
